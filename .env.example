# ZooKeeper and broker settings
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=2
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# Schema Registry
SCHEMA_REGISTRY_HOST_NAME=schema-registry
SCHEMA_REGISTRY_KAFKASTORE_TOPIC_REPLICATION_FACTOR=2

# Internal addresses used by Compose workers
KAFKA_DOCKER_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092
SCHEMA_REGISTRY_DOCKER_BASE_URL=http://schema-registry:8081

# Independent worker replicas in Docker
PRODUCER_REPLICAS=2
SINGLE_CONSUMER_REPLICAS=2
BATCH_CONSUMER_REPLICAS=2

# Application addresses (Docker network; override for execution outside Docker)
KAFKA_BASE_URL=kafka1:9092,kafka2:9092
SCHEMA_REGISTRY_BASE_URL=http://schema-registry:8081

# Application settings
KAFKA_ORDER_TOPIC=orders
KAFKA_SINGLE_GROUP_ID=orders-single
KAFKA_BATCH_GROUP_ID=orders-batch
KAFKA_BATCH_SIZE=10
KAFKA_FETCH_MIN_BYTES=1024
KAFKA_FETCH_WAIT_MS=500
KAFKA_PRODUCER_RETRIES=10
PRODUCE_INTERVAL=1
