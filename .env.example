# Docker images
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.0.1
KAFKA_IMAGE=confluentinc/cp-kafka:7.0.1
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:7.0.1
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

# ZooKeeper and broker settings
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA1_BROKER_ID=1
KAFKA2_BROKER_ID=2
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=2
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# External ports are mapped to fixed container ports 9094 / 9095.
# Changing these also changes the default advertised external addresses.
KAFKA_EXTERNAL_HOST=localhost
KAFKA1_EXTERNAL_PORT=9094
KAFKA2_EXTERNAL_PORT=9095
KAFKA1_LISTENERS=INTERNAL://0.0.0.0:9092,EXTERNAL://0.0.0.0:9094
KAFKA2_LISTENERS=INTERNAL://0.0.0.0:9092,EXTERNAL://0.0.0.0:9095
KAFKA1_ADVERTISED_LISTENERS=INTERNAL://kafka1:9092,EXTERNAL://${KAFKA_EXTERNAL_HOST}:${KAFKA1_EXTERNAL_PORT}
KAFKA2_ADVERTISED_LISTENERS=INTERNAL://kafka2:9092,EXTERNAL://${KAFKA_EXTERNAL_HOST}:${KAFKA2_EXTERNAL_PORT}

# Internal addresses shared by Docker app and Kafka UI
KAFKA_DOCKER_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092
SCHEMA_REGISTRY_DOCKER_BASE_URL=http://schema-registry:8081

# Schema Registry (external port maps to container port 8081)
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_HOST_NAME=schema-registry
SCHEMA_REGISTRY_LISTENERS=http://0.0.0.0:8081
SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=PLAINTEXT://kafka1:9092,PLAINTEXT://kafka2:9092
SCHEMA_REGISTRY_KAFKASTORE_TOPIC_REPLICATION_FACTOR=2

# Kafka UI (external port maps to container port 8080)
KAFKA_UI_PORT=8080
KAFKA_CLUSTERS_0_NAME=local

# Independent worker replicas in Docker
PRODUCER_REPLICAS=2
SINGLE_CONSUMER_REPLICAS=2
BATCH_CONSUMER_REPLICAS=2

# Host addresses for local Python execution: uv run --env-file .env app
KAFKA_BASE_URL=localhost:${KAFKA1_EXTERNAL_PORT},localhost:${KAFKA2_EXTERNAL_PORT}
SCHEMA_REGISTRY_BASE_URL=http://localhost:${SCHEMA_REGISTRY_PORT}

# Application settings shared by local execution and Docker
KAFKA_ORDER_TOPIC=orders
KAFKA_SINGLE_GROUP_ID=orders-single
KAFKA_BATCH_GROUP_ID=orders-batch
KAFKA_BATCH_SIZE=10
KAFKA_FETCH_MIN_BYTES=1024
KAFKA_FETCH_WAIT_MS=500
KAFKA_PRODUCER_RETRIES=10
PRODUCE_INTERVAL=1
